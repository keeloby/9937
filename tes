local espObjects = {}

local function createEspDrawings()
	return {
		box = Drawing.new("Square"),
		tracer = Drawing.new("Line"),
		name = Drawing.new("Text"),
		healthOutline = Drawing.new("Square"),
		healthBar = Drawing.new("Square")
	}
end

local function removeEspDrawings(drawings)
	for _, obj in pairs(drawings) do
		pcall(function() obj:Remove() end)
	end
end

RunService.RenderStepped:Connect(function()
	if not Drawing then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			if not espObjects[player] then
				espObjects[player] = createEspDrawings()
			end

			local objs = espObjects[player]
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if char and hrp and hum and hum.Health > 0 then
				local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)

				if onScreen then
					local head = char:FindFirstChild("Head")
					local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
					local legPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

					local height = math.abs(headPos.Y - legPos.Y)
					local width = height / 2

					objs.box.Visible = espSettings.boxes
					objs.box.Size = Vector2.new(width, height)
					objs.box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
					objs.box.Color = activeTheme.primary
					objs.box.Thickness = 1.5

					objs.tracer.Visible = espSettings.tracers
					objs.tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
					objs.tracer.To = Vector2.new(pos.X, pos.Y)
					objs.tracer.Color = activeTheme.primary
					objs.tracer.Thickness = 1

					objs.name.Visible = espSettings.names
					objs.name.Text = player.Name
					objs.name.Size = 13
					objs.name.Center = true
					objs.name.Outline = true
					objs.name.Position = Vector2.new(pos.X, pos.Y - height / 2 - 15)
					objs.name.Color = Color3.fromRGB(255, 255, 255)

					local healthPercent = hum.Health / hum.MaxHealth
					objs.healthOutline.Visible = espSettings.health
					objs.healthOutline.Size = Vector2.new(3, height)
					objs.healthOutline.Position = Vector2.new(pos.X - width / 2 - 6, pos.Y - height / 2)
					objs.healthOutline.Color = Color3.fromRGB(0, 0, 0)

					objs.healthBar.Visible = espSettings.health
					objs.healthBar.Size = Vector2.new(2, height * healthPercent)
					objs.healthBar.Position = Vector2.new(pos.X - width / 2 - 5, (pos.Y + height / 2) - (height * healthPercent))
					objs.healthBar.Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
					objs.healthBar.Filled = true
				else
					for _, obj in pairs(objs) do obj.Visible = false end
				end
			else
				for _, obj in pairs(objs) do obj.Visible = false end
			end
		end
	end
end)


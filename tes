			txtLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 40, 56)}):Play()
			TweenService:Create(switchKnob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = Color3.fromRGB(150, 160, 180)}):Play()
			TweenService:Create(rowStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(35, 48, 70)}):Play()
			txtLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
		end
	end

	return switchBg, setToggle, function() return state end
end


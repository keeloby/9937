local function createTab(name, icon, pageIndex)
	local xPosRatio = (pageIndex - 1) / totalTabs

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1/totalTabs, 0, 1, 0)
	btn.Position = UDim2.new(xPosRatio, 0, 0, 0)
	btn.BackgroundTransparency = 1
	btn.Text = icon .. " " .. name
	btn.TextColor3 = Color3.fromRGB(140, 150, 170)
	btn.Font = Enum.Font.GothamBold

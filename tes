	local function setToggle(val, silent)
		state = val
		if not silent then playSound(6895079853, 0.3, state and 1.5 or 0.9) end
		if state then
			TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = activeTheme.primary}):Play()
			TweenService:Create(switchKnob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(1, -12, 0.5, -5), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()

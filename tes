local function startFlying(mode)
	stopFlying()

	local char = localPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	flyMode = mode
	updateUIState()

	showNotif("🚀 " .. mode .. " FLY ACTIVE", "Speed: " .. tostring(flySpeedValue), activeTheme.primary)

	hum.PlatformStand = true
	local sparkParticles, trailList = applyVisualFX(hrp)

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = hrp

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bodyGyro.P = 60000 
	bodyGyro.D = 600   
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	currentVelocity = Vector3.zero
	currentRotationCFrame = CFrame.new(Vector3.zero, camera.CFrame.LookVector)

	TweenService:Create(hum, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {CameraOffset = Vector3.new(0, 1.1, 1.1)}):Play()

	flyConnection = RunService.Heartbeat:Connect(function(dt)
		if flyMode == "OFF" or not char or not hrp or not hum then
			stopFlying()
			return
		end

		local targetVelocity = Vector3.zero
		local moveDir = hum.MoveDirection
		local camCF = camera.CFrame
		local bobbing = Vector3.new(0, math.sin(tick() * 5) * 1.2, 0)

		if flyMode == "AUTO" then
			targetVelocity = camCF.LookVector * flySpeedValue
		elseif flyMode == "FREE" then
			if moveDir.Magnitude > 0 then
				local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
				flatLook = flatLook.Magnitude > 0.001 and flatLook.Unit or camCF.LookVector
				local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

				local forwardAmt = moveDir:Dot(flatLook)
				local rightAmt = moveDir:Dot(flatRight)

				local flyDir = (camCF.LookVector * forwardAmt) + (camCF.RightVector * rightAmt)
				if flyDir.Magnitude > 0 then
					targetVelocity = flyDir.Unit * flySpeedValue
				end
			else
				targetVelocity = bobbing
			end
		end

		local lookDir = (targetVelocity.Magnitude > 2) and targetVelocity.Unit or camCF.LookVector
		local tiltAngle = math.rad(-30)
		if currentStyle == "SUPERMAN" then tiltAngle = math.rad(-90)
		elseif currentStyle == "HOVER" then tiltAngle = math.rad(-10) end

		local targetRotation = CFrame.lookAt(Vector3.zero, lookDir) * CFrame.Angles(tiltAngle, 0, 0)

		currentRotationCFrame = currentRotationCFrame:Lerp(targetRotation, dt * 7)
		currentVelocity = currentVelocity:Lerp(targetVelocity, dt * 9)

		bodyGyro.CFrame = currentRotationCFrame
		bodyVelocity.Velocity = currentVelocity
		
		if fovWarpActive then
			local speedRatio = math.clamp(targetVelocity.Magnitude / 300, 0, 1)
			camera.FieldOfView = 70 + (speedRatio * 35)
		end

		local isMovingFast = targetVelocity.Magnitude > 5
		if sparkParticles then sparkParticles.Rate = isMovingFast and math.clamp(flySpeedValue / 2, 5, 200) or 0 end
		for _, tr in ipairs(trailList) do
			if tr then tr.Enabled = isMovingFast end
		end
	end)
end


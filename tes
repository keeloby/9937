-- 🛠️ MANUAL MODULE HOOK SYSTEM (TAB MODS)
-- ==========================================
local manualModPath = ""
local manualModKey = ""
local manualModValue = ""
local activeModuleHooks = {}
local customValueMap = {}

local function parseValue(valStr)
	local num = tonumber(valStr)
	if num ~= nil then return num end
	local lower = string.lower(valStr)
	if lower == "true" then return true end
	if lower == "false" then return false end
	return valStr
end

local function injectToTable(targetTable, key, rawValue)
	if type(targetTable) ~= "table" then return false end
	local val = parseValue(rawValue)
	
	if type(targetTable[key]) == "function" then
		targetTable[key] = function(...) return val end
		return true
	else
		rawset(targetTable, key, val)
		return true
	end
end

local function applyModuleHook(moduleInstance, keyName, rawValue)
	local success, modData = pcall(require, moduleInstance)
	if not success or type(modData) ~= "table" then
		return false, "Gagal require ModuleScript!"
	end

	-- KASUS 1: Key langsung ada di tabel
	if modData[keyName] ~= nil then
		local ok = injectToTable(modData, keyName, rawValue)
		if ok then return true, "Key '" .. keyName .. "' berhasil di-hook!" end
	end

	-- KASUS 2: Module berupa Class / Constructor (.new)
	local constructorKey = rawget(modData, "new") and "new" or (modData.new and "new" or nil)
	
	if constructorKey then
		if not activeModuleHooks[moduleInstance] then
			local oldConstructor = modData[constructorKey]
			activeModuleHooks[moduleInstance] = oldConstructor

			modData[constructorKey] = function(...)
				local createdObject = oldConstructor(...)
				if type(createdObject) == "table" and customValueMap[moduleInstance] then
					for k, v in pairs(customValueMap[moduleInstance]) do
						injectToTable(createdObject, k, v)
					end
                end
				return createdObject
			end
		end

		customValueMap[moduleInstance] = customValueMap[moduleInstance] or {}
		customValueMap[moduleInstance][keyName] = rawValue

		return true, "Class Hook aktif! Key '" .. keyName .. "' berubah saat dipakai."
	end

	return false, "Key tidak ditemukan & Module bukan Class/Constructor!"
end


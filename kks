-- HELPER FUNCTIONS
local function sendStoreRequest(targetInstance)
    if not storeRequestRemote or not targetInstance then return false end
    local success = pcall(function()
        if storeRequestRemote:IsA("RemoteEvent") then
            storeRequestRemote:FireServer(targetInstance)
        elseif storeRequestRemote:IsA("RemoteFunction") then
            storeRequestRemote:InvokeServer(targetInstance)
        end
    end)
    return success
end

local function sendUnstoreRequest()
    if not unstoreRequestRemote then return end
    pcall(function()
        if unstoreRequestRemote:IsA("RemoteEvent") then
            unstoreRequestRemote:FireServer()
        elseif unstoreRequestRemote:IsA("RemoteFunction") then
            unstoreRequestRemote:InvokeServer()
        end
    end)
end

local function isIgnoredItem(name)
    if blacklistNames[name] then return true end
    if name:sub(1, 6) == "Zombie" or name:find("DivineLighting") or name:find("Sound") or name:find("roblox_user") then 
        return true 
    end
    return false
end

local function isNearPlayer(instance)
    local player = Players.LocalPlayer
    local character = player and player.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("PrimaryPart")
    if not rootPart then return false end

    local targetPos = nil
    if instance:IsA("Model") then
        targetPos = instance:GetPivot().Position
    elseif instance:IsA("BasePart") then
        targetPos = instance.Position
    end

    if targetPos then
        local distance = (rootPart.Position - targetPos).Magnitude
        return distance <= SAFE_RADIUS
    end

    return false
end

local function getValidLootOptions()
    local options = {}
    local hash = {}

    if staticLootFolder then
        for _, child in ipairs(staticLootFolder:GetChildren()) do
            if not child:IsA("Folder") and not isIgnoredItem(child.Name) and not hash[child.Name] then
                hash[child.Name] = true
                table.insert(options, child.Name)
            end
        end
    end

    if grownFoodFolder then
        for _, child in ipairs(grownFoodFolder:GetChildren()) do
            if not child:IsA("Folder") and not isIgnoredItem(child.Name) and not hash[child.Name] then
                hash[child.Name] = true
                table.insert(options, child.Name)
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if not child:IsA("Folder") and not isIgnoredItem(child.Name) then
            if not hash[child.Name] and (child:IsA("Model") or child:IsA("Tool") or child:IsA("BasePart")) then
                hash[child.Name] = true
                table.insert(options, child.Name)
            end
        end
    end

    table.sort(options)
    if #options == 0 then table.insert(options, "No Items Found") end
    return options
end

local function triggerPrompt(target)
    for _, prompt in ipairs(target:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                task.wait(prompt.HoldDuration or 0.1)
                prompt:InputHoldEnd()
            end
        end
    end
end

local function isZombieObject(obj)
    local npcAnimsFolder = ReplicatedStorage:FindFirstChild("NpcAnims")
    local validNames = {}
    if npcAnimsFolder then
        for _, animObj in ipairs(npcAnimsFolder:GetChildren()) do
            validNames[animObj.Name:lower()] = true
        end
    end

    local objNameLower = obj.Name:lower()
    return validNames[objNameLower] or objNameLower:find("zombie") or objNameLower:find("npc") or objNameLower:find("rotter") or objNameLower:find("eye") or objNameLower:find("crawler")
end


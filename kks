MainTab:CreateToggle({
    Name = "🧱 Platform",
    CurrentValue = false,
    Flag = "PlatformToggle",
    Callback = function(Value)
        platformActive = Value
        if platformActive then
            local player = Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local root = character:WaitForChild("HumanoidRootPart")

            if not platformPart then
                platformPart = Instance.new("Part")
                platformPart.Name = "BuildPlatform_ZJ"
                platformPart.Size = Vector3.new(platformSize, 1, platformSize)
                platformPart.Anchored = true
                platformPart.CanCollide = true
                platformPart.Material = Enum.Material.SmoothPlastic
                platformPart.Transparency = 0.4
                platformPart.Color = Color3.fromRGB(0, 170, 255)
                platformPart.Parent = Workspace
            end

            -- Posisikan di bawah kaki karakter
            platformPart.CFrame = root.CFrame * CFrame.new(0, -3.5, 0)

            platformConnection = RunService.RenderStepped:Connect(function()
                if platformActive and platformPart and root and root.Parent then
                    -- Platform selalu mengikuti koordinat X dan Z karakter, namun Y (ketinggian) tetap diam
                    local currentY = platformPart.Position.Y
                    platformPart.CFrame = CFrame.new(root.Position.X, currentY, root.Position.Z)
                end
            end)

            Rayfield:Notify({Title = "Platform Active", Content = "Lantai melayang aktif di bawah kaku!", Duration = 3})
        else
            if platformConnection then platformConnection:Disconnect() end
            if platformPart then
                platformPart:Destroy()
                platformPart = nil
            end
            Rayfield:Notify({Title = "Platform Disabled", Content = "Lantai melayang telah dihapus.", Duration = 2})
        end
    end,
})


-- MISC TAB
MiscTab:CreateSection("🍎 Auto Eat Settings")

local autoEatActive = false
local eatThreshold = 70
local selectedFoodType = "All Foods"
local foodDropdownObj = nil

local function getGrownFoodOptions()
    local options = {"All Foods"}
    local hash = {}

    if grownFoodFolder then
        for _, child in ipairs(grownFoodFolder:GetChildren()) do
            if not child:IsA("Folder") and not hash[child.Name] then
                hash[child.Name] = true
                table.insert(options, child.Name)
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if not child:IsA("Folder") and not isIgnoredItem(child.Name) then
            if child.Name:lower():find("noodle") or child.Name:lower():find("food") or child.Name:lower():find("eat") then
                if not hash[child.Name] then
                    hash[child.Name] = true
                    table.insert(options, child.Name)
                end
            end
        end
    end

    table.sort(options)
    return options
end

foodDropdownObj = MiscTab:CreateDropdown({
    Name = "Select Food",
    Options = getGrownFoodOptions(),
    CurrentOption = {"All Foods"},
    Flag = "FoodTypeDropdown",
    Callback = function(Option) selectedFoodType = Option[1] end,
})

local function autoUpdateFoodDropdown()
    if foodDropdownObj then foodDropdownObj:Refresh(getGrownFoodOptions()) end
end

if grownFoodFolder then
    grownFoodFolder.ChildAdded:Connect(autoUpdateFoodDropdown)
    grownFoodFolder.ChildRemoved:Connect(autoUpdateFoodDropdown)
end

Workspace.ChildAdded:Connect(function(child)
    if child.Name:lower():find("noodle") or child.Name:lower():find("food") then autoUpdateFoodDropdown() end
end)

Workspace.ChildRemoved:Connect(function(child)
    if child.Name:lower():find("noodle") or child.Name:lower():find("food") then autoUpdateFoodDropdown() end
end)

MiscTab:CreateSlider({
    Name = "Auto Eat At (%)",
    Range = {1, 100},
    Increment = 1,
    CurrentValue = 70,
    Flag = "EatThresholdSlider",
    Callback = function(Value) eatThreshold = Value end,
})

MiscTab:CreateToggle({
    Name = "🍎 Auto Eat Food",
    CurrentValue = false,
    Flag = "AutoEatToggle",
    Callback = function(Value)
        autoEatActive = Value
        if Value then
            task.spawn(function()
                while autoEatActive do
                    local player = Players.LocalPlayer
                    local currentFood = player:GetAttribute("Food") or player:GetAttribute("Hunger") or 100

                    if currentFood < eatThreshold then
                        if eatRequestRemote then
                            local foodToEat = nil
                            if grownFoodFolder then
                                for _, foodModel in ipairs(grownFoodFolder:GetChildren()) do
                                    if selectedFoodType == "All Foods" or foodModel.Name == selectedFoodType then
                                        foodToEat = foodModel
                                        break
                                    end
                                end
                            end

                            if not foodToEat then
                                for _, child in ipairs(Workspace:GetChildren()) do
                                    if not child:IsA("Folder") then
                                        if selectedFoodType == "All Foods" then
                                            if child.Name:lower():find("noodle") or child.Name:lower():find("food") then
                                                foodToEat = child
                                                break
                                            end
                                        elseif child.Name == selectedFoodType then
                                            foodToEat = child
                                            break
                                        end
                                    end
                                end
                            end

                            if foodToEat then
                                pcall(function() eatRequestRemote:FireServer(foodToEat) end)
                                task.wait(0.3)
                            end
                        end
                    end
                    task.wait(1)
                end
            end)
        end
    end,
})


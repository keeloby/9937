        if Value then
            task.spawn(function()
                if not chopTreeRemote then
                    Rayfield:Notify({Title = "Error", Content = "ChopTreeEvent tidak ditemukan!", Duration = 3})
                    autoChopActive = false
                    autoChopToggleObj:Set(false)
                    return
                end

                local mapFolder = Workspace:FindFirstChild("Map_V5")
                local groupFolder = mapFolder and mapFolder:FindFirstChild("[new] rig, optimize & group ")

                if not groupFolder then
                    Rayfield:Notify({Title = "Error", Content = "Folder pohon tidak ditemukan di Workspace!", Duration = 3})
                    autoChopActive = false
                    autoChopToggleObj:Set(false)
                    return
                end

                local treeFolders = {
                    groupFolder:FindFirstChild("tree1"),
                    groupFolder:FindFirstChild("tree2"),
                    groupFolder:FindFirstChild("Pine Trees")
                }
                local hitVector = Vector3.new(0.904506266117096, 0.27559933066368103, -0.32544341683387756)

                while autoChopActive do
                    local choppedAny = false
                    for _, tFolder in ipairs(treeFolders) do
                        if tFolder then
                            for _, tree in ipairs(tFolder:GetChildren()) do
                                if not autoChopActive then break end
                                local hasLeaves = false
                                if tree:FindFirstChild("Leaves") then
                                    hasLeaves = true
                                else

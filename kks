                                        if desc.Name == "Leaves" then
                                            hasLeaves = true
                                            break
                                        end
                                    end
                                end

                                if hasLeaves and tree and tree.Parent then
                                    choppedAny = true
                                    for i = 1, 5 do
                                        if not autoChopActive then break end
                                        pcall(function() chopTreeRemote:FireServer(tree, 2.1, hitVector) end)

local function getCustomOPConfig(weaponName)
    if not originalGetConfig or not ValidGunsData then return nil end
    local config = originalGetConfig(ValidGunsData, weaponName)
    if not config then return config end

    local opConfig = {}
    for k, v in pairs(config) do
        opConfig[k] = v
    end

    opConfig["Damage"] = cfgDamage
    opConfig["HeadshotMultiplier"] = 100
    opConfig["FireDelay"] = cfgFireDelay
    opConfig["ReloadTime"] = cfgReloadTime
    opConfig["Spread"] = 0
    opConfig["BulletSpeed"] = cfgBulletSpeed
    opConfig["Ammo"] = cfgAmmo
    opConfig["ReserveAmmo"] = cfgAmmo
    opConfig["MaxReserve"] = cfgAmmo
    opConfig["IsAutomatic"] = true
    opConfig["BulletGravity"] = 0
    
    opConfig["Recoil"] = {
        ["VerticalMin"] = 0,
        ["VerticalMax"] = 0,
        ["HorizontalMin"] = 0,
        ["HorizontalMax"] = 0,
        ["RecoverySpeed"] = 100
    }

    if opConfig["IsMelee"] then
        opConfig["Reach"] = cfgReach

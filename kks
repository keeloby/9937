                            local survivorCFrame = survivor:IsA("Model") and survivor:GetPivot() or (survivor:IsA("BasePart") and survivor.CFrame)
                            if survivorCFrame then
                                root.CFrame = survivorCFrame * CFrame.new(0, 3, 0)
                                task.wait(0.15)
                                triggerPrompt(survivor)
                                task.wait(0.2)
                            end
                        end
                        if autoRescueActive then root.CFrame = originalPos end
                    end
                end
                autoRescueActive = false
                autoRescueToggleObj:Set(false)
                Rayfield:Notify({Title = "Finished", Content = "Semua survivor berhasil di-rescue & kembali ke posisi semula!", Duration = 3})
            end)
        end
    end,
})


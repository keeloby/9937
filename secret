-- Configuration & Platoboost SDK
local Platoboost = loadstring(game:HttpGet("https://raw.githubusercontent.com/Platoboost/Roblox-SDK/main/SDK.lua"))()

-- Inisialisasi Project Platoboost kamu (ID: 29355)
local Service = Platoboost.new(29355)

-- Cek apakah pemain sudah punya key yang valid
if Service:Verify() then
    -- JIKA KEY VALID: Panggil script utama kamu (kks)
    print("Key Valid! Menjalankan Script...")
    loadstring(game:HttpGet("https://raw.githubusercontent.com/keeloby/9937/refs/heads/main/kks"))()
else
    -- JIKA KEY BELUM VALID / BELUM LEWAT LINKVERTISE:
    -- Dapatkan link Linkvertise khusus pemain ini & salin ke clipboard
    local link = Service:GetLink()
    setclipboard(link)
    
    -- Tampilkan UI / Notifikasi ke pemain
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Platoboost Key System",
        Text = "Link Key sudah disalin ke Clipboard! Buka browser dan lewati Linkvertise.",
        Duration = 10
    })
    
    print("Link Key Kamu: " .. tostring(link))
end

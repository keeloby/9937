local Platoboost = loadstring(game:HttpGet("https://raw.githubusercontent.com/Platoboost/Roblox-SDK/main/SDK.lua"))()

-- Inisialisasi Service (ID Project Kamu: 29355)
local Service = Platoboost.new(29355)

-- Fungsi jika key valid / berhasil diverifikasi
local function OnSuccess()
    print("Key Valid! Menjalankan Script Utama...")
    loadstring(game:HttpGet("https://raw.githubusercontent.com/keeloby/9937/refs/heads/main/kks"))()
end

-- Cek apakah user sudah punya key yang tersimpan
if Service:Verify() then
    OnSuccess()
else
    -- Buka GUI Resmi Platoboost untuk input Key / Get Key
    Service:CreateUI({
        Title = "Key System",
        Description = "Lewati Linkvertise untuk mendapatkan key!",
        OnSuccess = OnSuccess
    })
end

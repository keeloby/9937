local Platoboost = loadstring(game:HttpGet("https://raw.githubusercontent.com/Platoboost/Roblox-SDK/main/SDK.lua"))()

-- Inisialisasi Service Platoboost ID Project Kamu (29355)
local Service = Platoboost.new(29355)

-- Fungsi jika Key Valid / Berhasil Lewati Linkvertise
local function OnSuccess()
    print("Key Valid! Menjalankan Script Utama...")
    -- MEMANGGIL FILE KKS KAMU
    loadstring(game:HttpGet("https://raw.githubusercontent.com/keeloby/9937/main/kks"))()
end

-- Cek apakah user sudah punya Key
if Service:Verify() then
    OnSuccess()
else
    -- Buka GUI Resmi Platoboost
    Service:CreateUI({
        Title = "Key System",
        Description = "Lewati Linkvertise untuk mendapatkan key!",
        OnSuccess = OnSuccess
    })
end
